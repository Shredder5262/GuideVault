# Build artifacts should never be part of the Docker build context.
**/bin/
**/obj/

# GuideVault runtime data is user-specific and must stay out of Docker images.
# This includes uploaded reader backgrounds, local settings, caches, histories,
# LaunchBox sync state, and generated library data.
**/data/

# Extra explicit guard for uploaded reader backgrounds if data layout changes later.
**/reader/backgrounds/
**/data/reader/backgrounds/

# Local/editor noise.
.git/
.vs/
.vscode/
*.user
*.suo
*.tmp
*.log
